def detect_stragglers(results):
    epoch_times = {
        pc_name: metrics["epoch_time"]
        for pc_name, metrics in results.items()
    }

    cluster_median = statistics.median(
        epoch_times.values()
    )

    # Worker is a straggler if it is more than
    # 20% slower than the cluster median.
    threshold = cluster_median * 1.20

    slowest_pc = max(
        epoch_times,
        key=epoch_times.get,
    )

    fastest_pc = min(
        epoch_times,
        key=epoch_times.get,
    )

    round_completion_time = max(
        epoch_times.values()
    )

    print("\nSTRAGGLER DETECTION")
    print("-" * 48)
    print(
        f"Cluster median time:   "
        f"{cluster_median:.4f}s"
    )
    print(
        f"Straggler threshold:   "
        f"{threshold:.4f}s"
    )
    print(
        f"Round completion time: "
        f"{round_completion_time:.4f}s"
    )
    print(
        f"Fastest worker:        "
        f"{fastest_pc}"
    )
    print(
        f"Slowest worker:        "
        f"{slowest_pc}"
    )

    detected_stragglers = []

    for pc_name, epoch_time in epoch_times.items():
        if epoch_time > threshold:
            status = "STRAGGLER"
            detected_stragglers.append(pc_name)

        elif pc_name == slowest_pc:
            status = "slowest, but within threshold"

        else:
            status = "normal"

        print(
            f"{pc_name}: "
            f"{epoch_time:.4f}s — {status}"
        )

    return detected_stragglers


def calculate_batch_allocation()(
    results,
    total_samples,
):
    # Estimated processing speed in samples/second.
    # Using samples divided by measured time is important
    # because later workers may receive different workloads.
    speeds = {
        pc_name: (
            metrics["samples"]
            / metrics["epoch_time"]
        )
        for pc_name, metrics in results.items()
    }

    total_speed = sum(speeds.values())

    raw_allocations = {
        pc_name: (
            speed/total_speed * TOTAL_BATCHES
        )
        for pc_name, speed in speeds.items()
    }

    # First assign the integer portion.
    allocations = {
        pc_name: int(raw_value)
        for pc_name, raw_value
        in raw_allocations.items()
    }

    remaining_samples = (
        total_samples
        - sum(allocations.values())
    )

    # Allocate leftover samples to workers with
    # the largest fractional remainders.
    decimal_order = sorted(
        raw_allocations,
        key=lambda pc_name: (
            raw_allocations[pc_name]
            - allocations[pc_name]
        ),
        reverse=True,
    )

    for pc_name in decimal_order[
        :remaining_samples
    ]:
        allocations[pc_name] += 1

    print("\nSUGGESTED ADAPTIVE ALLOCATION")
    print("-" * 48)

    for pc_name, batch_budget in allocations.items():
        percentage = (
            batch_budget
            / total_samples
            * 100
        )

        print(
            f"{pc_name}: "
            f"{batch_budget} batches "
            f"({percentage:.2f}%)"
        )

    print(
        f"Total: "
        f"{sum(allocations.values())} batches"
    )

    return allocations


