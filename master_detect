import json
import subprocess


USERNAME = "kgzh0394"

WORKERS = {
    "PC1": "localhost",
    "PC2": "uol-nsd000041.leeds.ac.uk",
    "PC3": "uol-bcpqk000684.leeds.ac.uk",
    "PC4": "uol-pc-055690.leeds.ac.uk",
}

PYTHON_PATH = "/tmp/kgzh0394/pytorch-cu128/bin/python"
TRAIN_SCRIPT = "/tmp/kgzh0394/gpu_straggler_project/train.py"

SUBSET_SIZE = 500
EPOCHS = 1
BATCH_SIZE = 64
NUM_WORKERS = 4


def build_training_command(pc_name):
    return (
        f"{PYTHON_PATH} {TRAIN_SCRIPT} "
        f"--worker-id {pc_name} "
        f"--subset-size {SUBSET_SIZE} "
        f"--epochs {EPOCHS} "
        f"--batch-size {BATCH_SIZE} "
        f"--num-workers {NUM_WORKERS}"
    )


def run_worker(pc_name, host):
    training_command = build_training_command(pc_name)

    print(f"\n{'=' * 60}")
    print(f"Running training on {pc_name}")
    print(f"Host: {host}")
    print(f"{'=' * 60}")

    try:
        if host == "localhost":
            result = subprocess.run(
                training_command,
                shell=True,
                capture_output=True,
                text=True,
                check=False,
            )
        else:
            ssh_command = [
                "ssh",
                f"{USERNAME}@{host}",
                training_command,
            ]

            result = subprocess.run(
                ssh_command,
                capture_output=True,
                text=True,
                check=False,
            )

    except Exception as error:
        print(f"{pc_name} could not be started: {error}")
        return None

    print(result.stdout)

    if result.returncode != 0:
        print(
            f"ERROR: {pc_name} exited with code "
            f"{result.returncode}"
        )

        if result.stderr:
            print(result.stderr)

        return None

    if result.stderr:
        print("Warnings:")
        print(result.stderr)

    for line in result.stdout.splitlines():
        if line.startswith("FINAL_METRICS "):
            metrics_text = line.removeprefix(
                "FINAL_METRICS "
            )

            try:
                return json.loads(metrics_text)

            except json.JSONDecodeError as error:
                print(
                    f"Could not parse metrics from "
                    f"{pc_name}: {error}"
                )
                return None

    print(
        f"No FINAL_METRICS line was found for {pc_name}."
    )

    return None


def print_summary(results):
    print(f"\n{'=' * 75}")
    print("PROFILING SUMMARY")
    print(f"{'=' * 75}")

    print(
        f"{'PC':<6}"
        f"{'GPU':<30}"
        f"{'Samples':<10}"
        f"{'Time (s)':<12}"
        f"{'Throughput':<12}"
    )

    print("-" * 75)

    for pc_name, metrics in results.items():
        print(
            f"{pc_name:<6}"
            f"{metrics['gpu']:<30}"
            f"{metrics['samples']:<10}"
            f"{metrics['epoch_time']:<12.4f}"
            f"{metrics['throughput']:<12.2f}"
        )


def detect_stragglers(results):
    epoch_times = {
        pc_name: metrics["epoch_time"]
        for pc_name, metrics in results.items()
    }

    average_time = (
        sum(epoch_times.values()) / len(epoch_times)
    )

    threshold = average_time * 1.5

    print("\nSTRAGGLER DETECTION")
    print("-" * 40)
    print(f"Average epoch time: {average_time:.4f}s")
    print(f"Threshold:          {threshold:.4f}s")

    for pc_name, epoch_time in epoch_times.items():
        if epoch_time > threshold:
            status = "STRAGGLER"
        else:
            status = "normal"

        print(
            f"{pc_name}: {epoch_time:.4f}s — {status}"
        )


def calculate_speeds(results):
    speeds = {
        pc_name: 1.0 / metrics["epoch_time"]
        for pc_name, metrics in results.items()
    }

    return speeds


def print_suggested_allocation(results):
    speeds = calculate_speeds(results)

    total_speed = sum(speeds.values())

    print("\nINITIAL SUGGESTED WORKLOAD SHARES")
    print("-" * 40)

    for pc_name, speed in speeds.items():
        percentage = speed / total_speed * 100

        print(
            f"{pc_name}: {percentage:.2f}%"
        )


def calculate_sample_allocation(
    results,
    total_samples=500,
):
    speeds = calculate_speeds(results)

    total_speed = sum(speeds.values())

    raw_allocations = {
        pc_name: (
            speeds[pc_name]
            / total_speed
            * total_samples
        )
        for pc_name in speeds
    }

    allocations = {
        pc_name: int(raw_allocations[pc_name])
        for pc_name in raw_allocations
    }

    allocated_so_far = sum(allocations.values())

    remaining_samples = (
        total_samples - allocated_so_far
    )

    decimal_order = sorted(
        raw_allocations,
        key=lambda pc_name: (
            raw_allocations[pc_name]
            - allocations[pc_name]
        ),
        reverse=True,
    )

    for pc_name in decimal_order[:remaining_samples]:
        allocations[pc_name] += 1

    print("\nSUGGESTED SAMPLE ALLOCATION")
    print("-" * 40)

    for pc_name, sample_count in allocations.items():
        percentage = (
            sample_count / total_samples * 100
        )

        print(
            f"{pc_name}: "
            f"{sample_count} images "
            f"({percentage:.2f}%)"
        )

    print(
        f"Total: {sum(allocations.values())} images"
    )

    return allocations


def main():
    results = {}

    for pc_name, host in WORKERS.items():
        metrics = run_worker(
            pc_name,
            host,
        )

        if metrics is not None:
            results[pc_name] = metrics

    if not results:
        print(
            "\nNo valid worker results were collected."
        )
        return

    print_summary(results)

    if len(results) != len(WORKERS):
        print(
            f"\nWarning: received results from "
            f"{len(results)} of "
            f"{len(WORKERS)} workers."
        )

    if len(results) >= 2:
        detect_stragglers(results)

        print_suggested_allocation(results)

        calculate_sample_allocation(
            results,
            total_samples=SUBSET_SIZE,
        )


if __name__ == "__main__":
    main()
