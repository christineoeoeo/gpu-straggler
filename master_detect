def run_worker_once(
    pc_name,
    host,
    subset_size,
):
    training_command = build_training_command(
        pc_name,
        subset_size,
    )

    try:
        if host == "localhost":
            result = subprocess.run(
                training_command,
                shell=True,
                capture_output=True,
                text=True,
                check=False,
            )

        else:
            ssh_command = [
                "ssh",
                f"{USERNAME}@{host}",
                training_command,
            ]

            result = subprocess.run(
                ssh_command,
                capture_output=True,
                text=True,
                check=False,
            )

    except Exception as error:
        print(
            f"{pc_name} could not start: {error}"
        )
        return None

    if result.returncode != 0:
        print(
            f"ERROR: {pc_name} exited with code "
            f"{result.returncode}"
        )

        if result.stdout:
            print(result.stdout)

        if result.stderr:
            print(result.stderr)

        return None

    for line in result.stdout.splitlines():
        if line.startswith("FINAL_METRICS "):
            metrics_text = line.removeprefix(
                "FINAL_METRICS "
            )

            try:
                return json.loads(metrics_text)

            except json.JSONDecodeError as error:
                print(
                    f"Could not parse metrics from "
                    f"{pc_name}: {error}"
                )
                return None

    print(
        f"No FINAL_METRICS line found for {pc_name}."
    )

    if result.stdout:
        print(result.stdout)

    if result.stderr:
        print(result.stderr)

    return None


def profile_worker(
    pc_name,
    host,
    subset_size,
):
    successful_runs = []

    print(f"\n{'=' * 60}")
    print(f"Profiling {pc_name}")
    print(f"Host: {host}")
    print(f"Allocated samples: {subset_size}")
    print(f"{'=' * 60}")

    for run_number in range(
        1,
        PROFILING_RUNS + 1,
    ):
        print(
            f"{pc_name} run "
            f"{run_number}/{PROFILING_RUNS}..."
        )

        metrics = run_worker_once(
            pc_name,
            host,
            subset_size,
        )

        if metrics is None:
            print(
                f"{pc_name} run "
                f"{run_number} failed."
            )
            continue

        successful_runs.append(metrics)

        print(
            f"Time: {metrics['epoch_time']:.4f}s, "
            f"throughput: "
            f"{metrics['throughput']:.2f}"
        )

    if len(successful_runs) < 2:
        print(
            f"Not enough successful runs for "
            f"{pc_name}."
        )
        return None

    # Ignore the first successful run as warm-up.
    measured_runs = successful_runs[1:]

    epoch_times = [
        metrics["epoch_time"]
        for metrics in measured_runs
    ]

    throughputs = [
        metrics["throughput"]
        for metrics in measured_runs
    ]

    median_time = statistics.median(
        epoch_times
    )

    median_throughput = statistics.median(
        throughputs
    )

    final_result = successful_runs[-1].copy()

    final_result["samples"] = subset_size
    final_result["epoch_time"] = median_time
    final_result["throughput"] = median_throughput
    final_result["profiling_times"] = epoch_times
    final_result["successful_runs"] = len(
        successful_runs
    )

    print(
        f"{pc_name} median time: "
        f"{median_time:.4f}s"
    )

    return final_result


